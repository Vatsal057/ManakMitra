# Copy to backend/.env and fill in. Real environment variables always win
# over this file (see src/translation/env.py -- it uses os.environ.setdefault),
# so a platform-injected value overrides whatever is here.

# Comma-separated list of browser origins allowed to call this API.
# http://localhost:3000 (the Vite dev server) is always allowed and does not
# need to be listed. Any *.vercel.app origin is also allowed via regex, so in
# practice you only need this for a custom domain.
ALLOWED_ORIGINS=https://your-app.vercel.app

# Optional. The default translation provider is local/offline (NLLB-200,
# see src/translation/nllb_provider.py) and needs no key. Set this only if
# you swap TranslationService's provider to GoogleTranslateProvider.
GOOGLE_TRANSLATE_API_KEY=
