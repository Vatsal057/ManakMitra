# Copy to .env and fill in as needed. Everything here is optional —
# the app runs with no configuration at all.

# Override the standards dataset the pipeline loads.
# MANAKMITRA_DATASET=data/bis_standards_dataset.json

# Enable real machine translation for multilingual queries.
# Without either of these, non-English input falls back to the offline
# procurement glossary in api/translation.py.
# GOOGLE_TRANSLATE_API_KEY=

# Or point at a self-hosted LibreTranslate instance instead.
# LIBRETRANSLATE_URL=http://localhost:5000
# LIBRETRANSLATE_API_KEY=
